<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Code</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background-color: #f4f6f9;
        color: #333333;
        line-height: 1.6;
      }

      .email-wrapper {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .email-header {
        background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
        padding: 40px 32px;
        text-align: center;
      }

      .email-header h1 {
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.3px;
      }

      .email-header p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 14px;
        margin-top: 6px;
      }

      .email-body {
        padding: 40px 32px;
      }

      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 16px;
      }

      .message {
        font-size: 15px;
        color: #555555;
        margin-bottom: 12px;
      }

      .otp-container {
        text-align: center;
        margin: 36px 0;
      }

      .otp-label {
        font-size: 13px;
        color: #888888;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .otp-code {
        display: inline-block;
        padding: 18px 40px;
        background-color: #f4f6f9;
        border: 2px dashed #1a73e8;
        border-radius: 10px;
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #1a73e8;
      }

      .expiry-notice {
        background-color: #fff8e1;
        border-left: 4px solid #f9a825;
        border-radius: 4px;
        padding: 12px 16px;
        margin-bottom: 28px;
      }

      .expiry-notice p {
        font-size: 13px;
        color: #7a6000;
      }

      .divider {
        border: none;
        border-top: 1px solid #eeeeee;
        margin: 28px 0;
      }

      .security-note {
        font-size: 13px;
        color: #888888;
      }

      .email-footer {
        background-color: #f4f6f9;
        padding: 24px 32px;
        text-align: center;
      }

      .email-footer p {
        font-size: 12px;
        color: #999999;
        margin-bottom: 4px;
      }

      .email-footer a {
        color: #1a73e8;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Tour Management System</h1>
        <p>One-Time Password (OTP) Verification</p>
      </div>

      <div class="email-body">
        <p class="greeting">Hello, <%= name %></p>

        <p class="message">
          We received a request that requires verification. Use the OTP code
          below to complete the process.
        </p>

        <div class="otp-container">
          <p class="otp-label">Your OTP Code</p>
          <span class="otp-code"><%= otp %></span>
        </div>

        <div class="expiry-notice">
          <p>
            This OTP code will expire in <strong>2 minutes</strong>. Please use
            it promptly.
          </p>
        </div>

        <hr class="divider" />

        <p class="security-note">
          If you did not request this code, please ignore this email. Your
          account remains secure and no action is required. Never share this
          code with anyone.
        </p>
      </div>

      <div class="email-footer">
        <p>
          &copy; <%= new Date().getFullYear() %> Tour Management System. All
          rights reserved.
        </p>
        <p>
          Need help?
          <a href="mailto:support@tourmanagement.com">Contact Support</a>
        </p>
      </div>
    </div>
  </body>
</html>
