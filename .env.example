# ==================== Server ====================
PORT = 5000
NODE_ENV = development
ALLOWED_ORIGINS = http://localhost:5000, http://localhost:5173

# ==================== Database ====================
DATABASE_URL = mongodb+srv://example_user:example_password@cluster0.llwcx8n.mongodb.net/example-db?appName=Cluster0

# ==================== JWT ====================
JWT_SECRET = your_strong_jwt_secret_here
JWT_EXPIRES_IN = 12h
JWT_REFRESH_SECRET = your_strong_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN = 7d
JWT_RESET_SECRET = your_strong_jwt_reset_secret_here
FORGET_PASSWORD_LIMIT_MIN = 30

# ==================== Bcrypt ====================
BCRYPT_SALT_ROUNDS = 10

# ==================== Super Admin ====================
SUPER_ADMIN_EMAIL = your_super_admin_email_here
SUPER_ADMIN_PASSWORD = your_super_admin_password_here
SUPER_ADMIN_PHONE = your_super_admin_phone_here
SUPER_ADMIN_PICTURE = your_super_admin_picture_url_here
SUPER_ADMIN_ADDRESS = your_super_admin_address_here

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID = your_google_client_id_here
GOOGLE_CLIENT_SECRET = your_google_client_secret_here
GOOGLE_CALLBACK_URL = your_google_callback_url_here

# ==================== Express Session ====================
EXPRESS_SESSION_SECRET = your_strong_express_session_secret_here

# ==================== Frontend URL ====================
FRONTEND_URL = http://localhost:5173

# ==================== SSLCommerz ====================
SSL_STORE_ID = your_sslcommerz_store_id_here
SSL_STORE_PASSWORD = your_sslcommerz_store_password_here
SSL_PAYMENT_URL = https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_URL = https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# ==================== SSLCommerz Frontend URLs ====================
SSL_SUCCEEDED_FRONTEND_URL = http://localhost:5173/api/v1/payment/succeeded
SSL_FAILED_FRONTEND_URL = http://localhost:5173/api/v1/payment/failed
SSL_CANCELLED_FRONTEND_URL = http://localhost:5173/api/v1/payment/cancelled

# ==================== SSLCommerz Backend URLs ====================
SSL_SUCCEEDED_BACKEND_URL = http://localhost:5000/api/v1/payment/succeeded
SSL_FAILED_BACKEND_URL = http://localhost:5000/api/v1/payment/failed
SSL_CANCELLED_BACKEND_URL = http://localhost:5000/api/v1/payment/cancelled

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY = your_cloudinary_api_key_here
CLOUDINARY_API_SECRET = your_cloudinary_api_secret_here
CLOUDINARY_FOLDER_NAME = tour-management-backend
CLOUDINARY_MAX_FILE_SIZE = 10485760 # 10 MB in bytes
CLOUDINARY_ALLOWED_FORMATS = jpg,jpeg,png,gif
CLOUDINARY_ALLOWED_EXTENSIONS = .jpg,.jpeg,.png,.gif
CLOUDINARY_MAX_IMAGE_WIDTH = 2000
CLOUDINARY_MAX_IMAGE_HEIGHT = 2000
CLOUDINARY_IMAGE_QUALITY = 80
CLOUDINARY_IMAGE_CROP = limit
CLOUDINARY_IMAGE_GRAVITY = auto

# ==================== GOOGLE SMTP ====================
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_USER = your-email@gmail.com
SMTP_PASS = your-app-password
SMTP_FROM_EMAIL = your-email@gmail.com

# ==================== REDIS ====================
REDIS_USERNAME = your_redis_username_here
REDIS_PASSWORD = your_redis_password_here
REDIS_HOST = your_redis_host_here
REDIS_PORT = your_redis_port_here